# copy to .env and fill in for anything other than local dev

# random secret string, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=False

# comma-separated, e.g. example.com,www.example.com
ALLOWED_HOSTS=

# SMTP settings for to-do reminder emails. Leave EMAIL_HOST unset to print
# reminder emails to the console instead (fine for local dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
